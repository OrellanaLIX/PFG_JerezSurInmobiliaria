# 1. Imagen base ultraligera de Node.js
FROM node:18-alpine

# 2. Directorio de trabajo dentro del contenedor
WORKDIR /app

# 3. Copiar archivos de dependencias primero (aprovecha la caché de Docker)
COPY package*.json ./

# 4. Instalar dependencias limpias
RUN npm ci

# 5. Copiar el resto del código del proyecto
COPY . .

# 6. SEGURIDAD: Cambiar al usuario "node" (ya viene creado en la imagen base)
# Evita ejecutar el contenedor como root
USER node

# 7. Informar el puerto que se va a usar
EXPOSE 5137

# 8. Comando de arranque forzando a Vite a escuchar en todas las interfaces (0.0.0.0)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5137"]