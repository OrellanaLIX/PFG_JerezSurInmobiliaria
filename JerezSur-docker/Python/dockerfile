# 1. Imagen base de Python optimizada
FROM python:3.10-slim

# 2. Evita archivos .pyc y fuerza el buffer de salida
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 3. Copiar e instalar dependencias primero
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copiar el código de la aplicación
COPY . .

# 5. Seguridad: usuario sin privilegios
RUN useradd -m pythonuser
USER pythonuser

# 6. Puerto de Flask
EXPOSE 5000

# 7. Arrancar Flask vinculado a todas las interfaces del contenedor
CMD ["flask", "--app", "app.py", "run", "--host=0.0.0.0", "--port=5000"]
